{
  "expo": {
    "name": "GraveFinder",
    "slug": "gravefinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": false, "infoPlist": { "NSLocationWhenInUseUsageDescription": "Your location is used to show how far you are from a grave. The app also works without it." } },
    "android": { "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"] },
    "plugins": ["expo-location"]
  }
}
